{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File '.claude/hooks/pre-commit-security.ps1'",
            "shell": "bash",
            "statusMessage": "Verificando seguridad pre-commit...",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "PowerShell(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File '.claude/hooks/pre-commit-security.ps1'",
            "shell": "bash",
            "statusMessage": "Verificando seguridad pre-commit...",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash(git push*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[POST-PUSH] Cambios publicados en GitHub. Verificar deploy en Netlify.'",
            "shell": "bash",
            "statusMessage": "Recordatorio post-push..."
          }
        ]
      }
    ]
  }
}
